@page "/"

<PageTitle>Home | ConnectX</PageTitle>

<section class="home-panel border rounded-3 p-4 p-md-5">
    <p class="text-body-secondary mb-2">ConnectX</p>
    <h1 class="display-6 fw-semibold mb-3">Welcome</h1>
    <p class="lead text-body-secondary mb-4">
        A simple place to manage your account and, when you have access, the users and settings for this application.
    </p>

    <AuthorizeView Context="userContext">
        <Authorized>
            <a class="btn btn-primary" href="Account/Manage">Manage your account</a>
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <a class="btn btn-outline-secondary ms-2" href="admin">Manage users</a>
                </Authorized>
            </AuthorizeView>
        </Authorized>
        <NotAuthorized>
            <a class="btn btn-primary" href="Account/Login">Sign in</a>
            <a class="btn btn-outline-secondary ms-2" href="Account/Register">Create account</a>
        </NotAuthorized>
    </AuthorizeView>
</section>
